#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

case "$1" in
	--make-workspace-integrations)
		shift

		if [ "$MDLT_ORIGIN" = "$MMDAPP/.local" ] ; then
			touch "$MMDAPP/.local/MDSC.deploy.settings.env"
		fi

		DistroDeployTools --make-console-command "$@"
		return 0
	;;
	--make-console-command)
		shift
		set -e
		# shortcut for: `DistroDeployTools --make-console-script`
		. "$MDLT_ORIGIN/myx/myx.distro-deploy/sh-lib/DeployTools.Make.DistroDeployConsoleShellScript.include" \
		> "$MMDAPP/DistroDeployConsole.sh"
		chmod 770 "$MMDAPP/DistroDeployConsole.sh"

		if [ "$1" != "--quiet" ] ; then
			local consoles="$( ls $MMDAPP/Distro*Console.sh | sed 's|^|	|g' )"
			printf \
				"\nNote: DistroDeployConsole.sh created, now you can run:\n%s\n\n" \
				"$consoles" \
			>&2
		fi

		return 0
	;;
	--make-console-script)
		shift

		. "$MDLT_ORIGIN/myx/myx.distro-deploy/sh-lib/DeployTools.Make.DistroDeployConsoleShellScript.include"

		return 0
	;;
	*)
		echo "⛔ ERROR: $MDSC_CMD: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
